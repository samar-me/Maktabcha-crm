# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Admin Key (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Auth User Credentials (Used server-side by PIN login to establish real Supabase session)
MAKTABCHA_SUPABASE_EMAIL=your-private-crm-admin@example.com
MAKTABCHA_SUPABASE_PASSWORD=your-private-crm-password

# Master Security Password (Used only for first-time PIN setup and PIN reset/recovery)
MAKTABCHA_MASTER_PASSWORD=your-secure-master-password

# Telegram Bot Integration (Server-only)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-telegram-bot-username
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# AI Assignment Generator Configuration (Server-only)
# Supported providers: gemini (default), openai, custom
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.5-flash

# App Configuration
NEXT_PUBLIC_APP_NAME="Maktabcha CRM"
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
