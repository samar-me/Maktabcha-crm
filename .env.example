# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Master Security Password for first-time login and PIN reset
MAKTABCHA_MASTER_PASSWORD=your-secure-master-password

# Optional: Service Role Key for backend administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_NAME="Maktabcha CRM"
NEXT_PUBLIC_APP_URL=http://localhost:3000
